(version 1)

# 4-layer, 2oz copper outer
(rule "Minimum Trace Width and Spacing (inner layer)"
	(constraint track_width (min 8mil))
	(constraint clearance (min 8mil))
	(condition "A.Type == 'track' && A.existsOnLayer('In1.Cu')"))

(rule "Minimum Trace Width and Spacing (inner layer 2)"
	(constraint track_width (min 8mil))
	(constraint clearance (min 8mil))
	(condition "A.Type == 'track' && A.existsOnLayer('In2.Cu')"))

(rule "Minimum Trace Width and Spacing (outer layer front)"
	(constraint track_width (min 8mil))
	(constraint clearance (min 8mil))
	(condition "A.Type == 'track' && A.existsOnLayer('F.Cu')"))

(rule "Minimum Trace Width and Spacing (outer layer back)"
	(constraint track_width (min 8mil))
	(constraint clearance (min 8mil))
	(condition "A.Type == 'track' && A.existsOnLayer('B.Cu')"))

# silkscreen
(rule "Minimum line width front silkscreen"
	(constraint track_width (min 6mil))
	(condition "A.existsOnLayer('F.Silkscreen')"))

(rule "Minimum line width back silkscreen"
	(constraint track_width (min 6mil))
	(condition "A.existsOnLayer('B.Silkscreen')"))

(rule "Pad to Silkscreen"
	(constraint clearance (min 0.15mm))
	(condition "A.Type == 'pad' && (B.Type == 'text' || B.Type == 'graphic') && (A.existsOnLayer('F.Cu') || A.existsOnLayer('B.Cu'))"))

# edge clearance
(rule "Trace to Outline"
	(constraint edge_clearance (min 0.2mm))
	(condition "A.Type == 'track'"))

(rule "Trace to V-Cut"
	(constraint clearance (min 0.4mm))
	(condition "A.Type == 'track' && B.Layer == 'Edge.Cuts'"))

# drill/hole size
(rule "drill hole size (mechanical)"
	(constraint hole_size (min 0.2mm) (max 6.3mm))
	(condition "A.Type == 'pad' && A.Pad_Type == 'NPTH, mechanical'"))

(rule "Minimum Via Hole Size"
	(constraint hole_size (min 0.2mm))
	(condition "A.Type == 'via'"))

(rule "Minimum Via Diameter"
	(constraint via_diameter (min 0.4mm))
	(condition "A.Type == 'via'"))

(rule "PTH Hole Size"
	(constraint hole_size (min 0.2mm) (max 6.35mm))
	(condition "A.Type == 'pad' && A.isPlated()"))

(rule "PTH Size"
	(constraint via_diameter (min 0.7mm) (max 6.35mm))
	(condition "A.Type == 'pad' && A.isPlated()"))

(rule "Minimum Non-plated Hole Size"
	(constraint hole_size (min 0.5mm))
	(condition "A.Type == 'pad' && !A.isPlated()"))

# clearance
(rule "via to track clearance"
	(constraint hole_clearance (min 0.254mm))
	(condition "A.Type == 'via' && B.Type == 'track'"))

(rule "via to via clearance (same nets)"
	(constraint hole_clearance (min 0.254mm))
	(condition "A.Type == 'via' && B.Type == 'via' && A.Net == B.Net"))

(rule "pad to pad clearance (with hole, different nets)"
	(constraint hole_clearance (min 0.5mm))
	(condition "A.Type == 'pad' && A.Pad_Type == 'Through-hole' && B.Type == 'pad' && B.Pad_Type == 'Through-hole' && A.Net != B.Net"))

(rule "pad to pad clearance (without hole, different nets)"
	(constraint clearance (min 0.127mm))
	(condition "A.Type == 'pad' && B.Type == 'pad' && A.Net != B.Net"))

(rule "NPTH to Track clearance"
	(constraint hole_clearance (min 0.254mm))
	(condition "A.Type == 'pad' && A.Pad_Type == 'NPTH, mechanical' && B.Type == 'track'"))

(rule "PTH to Track clearance"
	(constraint hole_clearance (min 0.33mm))
	(condition "A.Type == 'pad' && A.isPlated() && B.Type == 'track'"))

(rule "Pad to Track clearance"
	(constraint clearance (min 0.2mm))
	(condition "A.Type == 'pad' && A.isPlated() && B.Type == 'track'"))